__pycache__/
*.pyc
.DS_Store
.pytest_cache/
*.tmp*

# Cache: ignore parquet/pkl/json by default, then un-ignore the small committed
# snapshot files the deploy image needs. Raw boxscore JSON (2.8GB) stays OUT of
# git and rebuilds from the API. The per-season gamelog parquets ARE committed
# (~9MB total): the daily GitHub Action needs them to append each day's games
# without a full refetch, and a fresh clone gets working features offline.
cache/*.parquet
cache/*.pkl
cache/*.json
cache/*.log
cache/raw_boxscores/
cache/raw_statcast/
!cache/gamelogs_*.parquet
!cache/park_factors_*.parquet
!cache/statcast_*.parquet
!cache/sprint_speed_*.parquet
!cache/arsenal_*.parquet
!cache/disc_*.parquet
!cache/game_weather_v1.parquet
!cache/game_airdensity_v1.parquet
!cache/venues_v1.parquet
!cache/tto_pit_*.parquet
!cache/fbvelo_*.parquet
!cache/framing2_*.parquet
!cache/platoon2_*.parquet
!cache/batvelo2_*.parquet
!cache/relspin2_*.parquet
!cache/mix2_*.parquet
!cache/batproc2_*.parquet
!cache/catcher_framing_*.parquet
!cache/catcher_throwing_*.parquet
!cache/player_universe_*.parquet
!cache/predictions_*.parquet
!cache/slate_*.json
!cache/accuracy_history_*.parquet
# props_history holds LINE VALUES from a third-party mirror of the PrizePicks
# API (no licence, derived from collection their ToS bars). Private on purpose:
# only the derived aggregate below is published.
!cache/props_summary_*.json
# The fitted predictive distributions. MUST be committed: the deployed app
# reads it to compute P(Over). Fit on our OWN accuracy history, so it
# contains no third-party line data.
!cache/prop_calibration_*.json
cache/raw_airdensity/

# ── Accuracy page: LOCAL ONLY, deliberately not on the public site ──────────
# The page and the aggregate that feeds it are kept out of the repo so the
# model-vs-baseline record and the PrizePicks board scoreboard are not public.
# theme.py._NAV_PAGES has no Accuracy entry to match; keep the two in sync, or
# a nav link to a missing page renders as a broken site.
pages/Accuracy.py
cache/props_summary_*.json
